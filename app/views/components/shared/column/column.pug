aside(id="column") 
  span(id="colcollapse", class="icon-cheveron-up hide")
  h4= __('column.exchanges')
  cmp-navigation
    span(slot="list")
      li(class="cmp-navigation-slotted-li")
        a(href="global", class="cmp-navigation-slotted-a")=  __('exchanges.globalStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="milan", class="cmp-navigation-slotted-a")=  __('exchanges.milanStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="paris", class="cmp-navigation-slotted-a")=  __('exchanges.parisStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="oslo", class="cmp-navigation-slotted-a")=  __('exchanges.osloStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="amsterdam", class="cmp-navigation-slotted-a")=  __('exchanges.amsterdamStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="brussels", class="cmp-navigation-slotted-a")=  __('exchanges.brusselsStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="lisbon", class="cmp-navigation-slotted-a")=  __('exchanges.lisbonStockExchange')
      li(class="cmp-navigation-slotted-li")
        a(href="dublin", class="cmp-navigation-slotted-a")=  __('exchanges.dublinStockExchange')
  div(class="col-widget")
    h4= __('column.telegram')
    p= __('column.telegramText')
    a(href="https://t.me/tradingradarnet", title="Telegram")= __('column.telegramCTA') 
      i(class="icon-telegram")
  div(class="col-widget partner")
    h4= __('column.AVA')
    div
      p(class="center")= __('column.AVAText1')
      p(class="center", id="ava-banner-0")
    div
      p(class="center")= __('column.AVAText2')  
      p(class="center", id="ava-banner-1")
    div
      p(class="center")= __('column.AVAText3')    
      p(class="center", id="ava-banner-2")
