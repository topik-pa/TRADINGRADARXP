- 
  let links = [
    {
      id: 'hp',
      name: __('header.home'),
      url: '/'
    },
    {
      id: 'stocks',
      name: __('header.stocks'),
      url: '/stocks'
    },
    {
      id: 'about',
      name: __('header.about'),
      url: '/about'
    },
    {
      id: 'contacts',
      name: __('header.contacts'),
      url: '/contacts'
    }
  ] 
span(class="hamburger icon-menu") 
nav(id="main-menu")
  div
    span(class="close icon-close")
    ul
      each link in links
        li(class = (id === link.id) ? "active" : "")
          if link.class
            span(class=link.class)
          a(href='/'+locale + link.url, title=link.name) #{link.name}
  