- 
  let links = [
    {
      id: 'hp',
      name: 'Home',
      url: '/'
    },
    {
      id: 'stock',
      name: 'Azioni',
      url: 'aasen-sparebank'
    },
    {
      id: 'tpr',
      name: 'Target price',
      url: '/target-price'
    },
    {
      id: 'dividendi',
      name: 'Dividendi',
      url: '/dividendi'
    },
    {
      id: 'contatti',
      name: 'Contatti',
      url: '/contatti'
    }
  ] 
span(class="hamburger icon-menu") 
nav(id="main-menu")
  div
    span(class="close icon-close")
    ul
      each link in links
        li(class = (id === link.id) ? "active" : "")
          if link.class
            span(class=link.class)
          a(href=link.url, title=link.name) #{link.name}
  