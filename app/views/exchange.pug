extends layout.pug

block append meta
  meta(name="og:title" content="")
  meta(name="og:description" content="")
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('privacy') + ' | ' + proj_name
  meta(name="description" content=__('privacy'))
  meta(name="keywords" content="")

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ./components/shared/breadcrumbs/breadcrumbs.pug
  h1= __(`${exchange}StockExchange`)

  section
    h2 Titoli in rally oggi lunedì 13 febbraio
    div
      h3 Azioni in rally rialzista
      div(id="bests", class="bullet-wrap")
    div
      h3 Azioni in rally ribassista
      div(id="worsts", class="bullet-wrap")

  section
    h2 Le performance più interessanti
    h3 Migliori perfomance rialziste dell'ultimo mese
    div(id="performance-up", class="bullet-wrap")
    h3 Peggiori perfomance ribassiste dell'ultimo mese
    div(id="performance-down", class="bullet-wrap")


block column 
  include ./components/shared/column/column.pug
