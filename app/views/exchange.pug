extends layout.pug

block append meta
  meta(name="og:title" content= __(`exchanges.${exchange}StockExchange`) + ' | ' + __('proj_name') )
  meta(name="og:description" content=__('exchange.meta.description'))
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __(`exchanges.${exchange}StockExchange`) + ' | ' + __('proj_name')
  meta(name="description" content=__('exchange.meta.description', {exchange: __(exchange)}))
  meta(name="keywords" content=__('exchange.meta.keywords', {keywords: __(exchange)}))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ./components/shared/breadcrumbs/breadcrumbs.pug

  h1= __(`exchanges.${exchange}StockExchange`)

  section
    h2!= __('rallyTitle', { date: new Date().toLocaleDateString(locale ,{ weekday:'long', day:'numeric', month:'long' })})
    div
      h3= __('rallyUpSubtitle')
      div(id="bests", class="bullet-wrap")
    div
      h3= __('rallyDownSubtitle')
      div(id="worsts", class="bullet-wrap")

  section
    h2= __('performanceTitle')
    div(class="list-wrapper")
      div(id="perf-month-up")
        h3= __('performanceSubtitleUp')
        ul(id="performance-up", class="trlist rank")
      div(id="perf-month-down")
        h3= __('performanceSubtitleDown')
        ul(id="performance-down", class="trlist rank")

  aside(id="disclaimer")!= __('disclaimer')


block column 
  include ./components/shared/column/column.pug
