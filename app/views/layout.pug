-
  let prod = process.env.NODE_ENV === 'production'
  let proj_name = 'tradingradar.net'
  let proj_tagline = 'Titoli sull\'orlo di un crisi di nervi'
  let proj_description = 'tradingradar.net - Titoli sull\'orlo di un crisi di nervi'
  let proj_url = 'https://tradingradar.net'
  let proj_copy = 2025
  let proj_owner = 'Marco Pavan'
  let proj_email = 'info@tradingradar.net'
  let proj_logo = 'https://tradingradar.net/assets/images/logo.webp'
  let og_image = 'https://tradingradar.net/assets/images/tr-og-image.webp'
  let socials = [
    {
      name: 'Telegram',
      url: 'https://t.me/tradingradarnet/',
      icon: 'icon-telegram'
    },
    {
      name: 'LinkedIn',
      url: 'https://www.linkedin.com/in/markopavan/',
      icon: 'icon-linkedin2'
    },
    {
      name: 'Mail',
      url: 'mailto:info@tradingradar.net',
      icon: 'icon-envelop'
    }
  ]

doctype html
html(lang=locale)
  head
    block meta 
      meta(charset="utf-8")
      meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
      meta(name="author" content=proj_owner + ' - ' + proj_email)
      link(rel="shortcut icon", href="/favicon.ico", type="image/x-icon")
      if prod
        link(rel="stylesheet", type="text/css", href="/dist/main.css")
        script(src='/dist/bundle.js', defer)
      else
        link(rel="stylesheet", type="text/css", href="/styles/main.css")
        script(src='/scripts/index.js', type='module', defer)
      link(rel="dns-prefetch" href="https://www.statcounter.com/")
      link(rel="dns-prefetch" href="https://c.statcounter.com/")
      link(rel="dns-prefetch" href="https://tracking.avapartner.com/")
      meta(name="og:type" content="website")
      meta(name="og:site_name" content=proj_name)
  body(id=id, class="view " + className)
    include ./components/shared/header/header.pug
    div(class="layout")
      aside
        block column
      main
        block main
    include ./components/shared/footer/footer.pug
    include ./components/shared/goto_top/goto_top.pug
    script(type='application/ld+json').
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "url": "#{proj_url}",
        "name": "#{proj_name}",
        "description": "#{proj_description}",
        "image": "#{proj_logo}",
        "author": {
          "@type": "Person",
          "name": "#{proj_owner}"
        },
        "copyrightHolder": {
          "@type": "Person",
          "name": "#{proj_owner}"
        }
      }
    
