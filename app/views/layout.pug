-
  let prod = process.env.NODE_ENV === 'production'
  let proj_name = 'rallyingstocks.com'
  let proj_tagline= __('proj_tagline')
  let proj_url = 'https://rallyingstocks.com'
  let proj_copy = 2025
  let proj_owner = 'Marco Pavan'
  let proj_email = 'info@rallyingstocks.com'
  let proj_logo = 'https://rallyingstocks.com/assets/images/logo.webp'
  let og_image = 'https://rallyingstocks.com/assets/images/tr-og-image.webp'
  let sc_project = 13184567
  let sc_security = '7ee815df'

doctype html
html(lang=locale)
  head
    block meta 
      meta(charset="utf-8")
      meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
      meta(name="author" content=proj_owner + ' - ' + proj_email)
      link(rel="shortcut icon", href="/favicon.ico", type="image/x-icon")
      if prod
        link(rel="stylesheet", type="text/css", href="/dist/main.css")
        script(src='/dist/bundle.js', defer)
      else
        link(rel="stylesheet", type="text/css", href="/styles/main.css")
        script(src='/scripts/index.js', type='module', defer)
      link(rel="dns-prefetch" href="https://www.statcounter.com/")
      link(rel="dns-prefetch" href="https://c.statcounter.com/")
      link(rel="dns-prefetch" href="https://tracking.avapartner.com/")
      meta(name="og:type" content="website")
      meta(name="og:site_name" content=proj_name)
  body(id=id, data-exchange=exchange, data-stock=slug)
    include ./components/shared/header/header.pug
    div(class="layout")
      block column
      main(class=className)
        block main
    include ./components/shared/cookie_layer/cookie_layer.pug
    include ./components/shared/footer/footer.pug
    include ./components/shared/goto_top/goto_top.pug
    script(nonce=nonce).
        var sc_project = #{sc_project};
        var sc_invisible = 1;
        var sc_security = "#{sc_security}";
    script(async, defer, src='https://www.statcounter.com/counter/counter.js', nonce=nonce)
    script(type='application/ld+json').
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://rallyingstocks.com/#organization",
            "name": "rallyingstocks.com",
            "url": "https://rallyingstocks.com",
            "logo": "https://rallyingstocks.com/assets/images/logo.webp",
            "description": "rallyingstocks.com shows european stock market shares with prices and volumes in sharp movement",
            "sameAs": [
              "https://t.me/rallyingstocks",
              "https://www.linkedin.com/in/markopavan/"
            ],
            "founder": {
              "@type": "Person",
              "name": "Marco Pavan"
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://rallyingstocks.com/#website",
            "name": "rallyingstocks.com",
            "url": "https://rallyingstocks.com",
            "publisher": {
              "@id": "https://rallyingstocks.com/#organization"
            }
          }
        ]
      }
    
