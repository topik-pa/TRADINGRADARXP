extends layout.pug

block append meta
  meta(name="og:title" content=__('views.contacts') + ' | ' + __('proj_name'))
  meta(name="og:description" content=__('contacts.meta.description'))
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('views.contacts') + ' | ' + proj_name
  meta(name="description" content=__('contacts.meta.description'))
  meta(name="keywords" content=__('contacts.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  h1= __('contacts.title')
  p= __('contacts.text')
  section 
      h2= __('contacts.subTitleEMail')
      p= __('contacts.textEMail')
        a(href="mailto:" + proj_email) #{proj_email}

block column 
  include ./components/shared/column/column.pug        
