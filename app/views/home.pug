extends layout.pug

block append meta
  meta(name="og:title" content=__('views.home') + ' | ' + __('proj_name') )
  meta(name="og:description" content=__('proj_description'))
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('views.home') + ' | ' + __('proj_name') 
  meta(name="description" content=__('proj_description'))
  meta(name="keywords" content=__('index.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  section(class="flex head")
    div(class="rounded")
      h1!= __('proj_name')
      p!= __('index.description')
    div(class="rounded")
      h2!= __('index.subtitle')
      p!= __('index.rally')

  section
    h2!= __('rallyTitle')
    p(class="update")= __('update')
      em
    //- p!= __('rallyText')
    div
      h3= __('rallyUpSubtitle')
      div(id="bests", class="bullet-wrap")
    div
      h3= __('rallyDownSubtitle')
      div(id="worsts", class="bullet-wrap")

  section
    h2= __('performanceTitle')
    p(class="update")= __('update')
      em
    //- p!= __('performanceText')
    div(class="list-wrapper")
      div(id="perf-month-up")
        h3= __('performanceSubtitleUp')
        ul(id="performance-up", class="trlist rank")
      div(id="perf-month-down")
        h3= __('performanceSubtitleDown')
        ul(id="performance-down", class="trlist rank")

  section
    h2= __('index.sectionExchanges.title')
    //- p!= __('index.sectionExchanges.text')
    div(id="cards")
      cmp-card
        span(slot="title")= __('exchanges.globalStockExchange')
        a(slot="image", title=__('exchanges.globalStockExchange'), href="global")
          img(src="/assets/images/exchanges/placeholder.jpg", width="262", height="262", loading="lazy", alt=__('exchanges.globalStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.globalStockExchange')
        span(slot="description")= __('exchanges.euronextGlobalDescription')
        span(slot="link")
          a(href="global", title=__('exchanges.globalStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.milanStockExchange')
        a(slot="image", title=__('exchanges.milanStockExchange'), href="milan")
          img(src="/assets/images/exchanges/borsa-italiana.webp", width="262", height="262", loading="lazy", alt=__('exchanges.milanStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.milanStockExchange')
        span(slot="description")= __('exchanges.milanStockExchangeDescription')
        span(slot="link")
          a(href="milan", title=__('exchanges.milanStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.parisStockExchange')
        a(slot="image", title=__('exchanges.parisStockExchange'), href="paris")
          img(src="/assets/images/exchanges/bourse_de_paris.webp", width="262", height="262", loading="lazy", alt=__('exchanges.parisStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.parisStockExchange')
        span(slot="description")= __('exchanges.parisStockExchangeDescription')
        span(slot="link")
          a(href="paris", title=__('exchanges.parisStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.osloStockExchange')
        a(slot="image", title=__('exchanges.osloStockExchange'), href="oslo")
          img(src="/assets/images/exchanges/placeholder.jpg", width="262", height="262", loading="lazy", alt=__('exchanges.osloStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.osloStockExchange')
        span(slot="description")= __('exchanges.osloStockExchangeDescription')
        span(slot="link")
          a(href="oslo", title=__('exchanges.osloStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.amsterdamStockExchange')
        a(slot="image", title=__('exchanges.amsterdamStockExchange'), href="amsterdam")
          img(src="/assets/images/exchanges/placeholder.jpg", width="262", height="262", loading="lazy", alt=__('exchanges.amsterdamStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.amsterdamStockExchange')
        span(slot="description")= __('exchanges.amsterdamStockExchangeDescription')
        span(slot="link")
          a(href="amsterdam", title=__('exchanges.amsterdamStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.brusselsStockExchange')
        a(slot="image", title=__('exchanges.brusselsStockExchange'), href="brussels")
          img(src="/assets/images/exchanges/placeholder.jpg", width="262", height="262", loading="lazy", alt=__('exchanges.brusselsStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.brusselsStockExchange')
        span(slot="description")= __('exchanges.brusselsStockExchangeDescription')
        span(slot="link")
          a(href="brussels", title=__('exchanges.brusselsStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.lisbonStockExchange')
        a(slot="image", title=__('exchanges.lisbonStockExchange'), href="lisbon")
          img(src="/assets/images/exchanges/placeholder.jpg", width="262", height="262", loading="lazy", alt=__('exchanges.lisbonStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.lisbonStockExchange')
        span(slot="description")= __('exchanges.lisbonStockExchangeDescription')
        span(slot="link")
          a(href="lisbon", title=__('exchanges.lisbonStockExchange'))= __('index.sectionExchanges.discover')

      cmp-card
        span(slot="title")= __('exchanges.dublinStockExchange')
        a(slot="image", title=__('exchanges.dublinStockExchange'), href="dublin")
          img(src="/assets/images/exchanges/placeholder.jpg", width="262", height="262", loading="lazy", alt=__('exchanges.dublinStockExchange'), class="cmp-card-slotted-img")
        span(slot="subtitle")= __('exchanges.dublinStockExchange')
        span(slot="description")= __('exchanges.dublinStockExchangeDescription')
        span(slot="link")
          a(href="dublin", title=__('exchanges.dublinStockExchange'))= __('index.sectionExchanges.discover')                        
  
  section(class="center")
    h2= __('index.sectionAVA.title')
    p= __('index.sectionAVA.text')
    p(id="ava-banner-3")

  aside(id="disclaimer")!= __('disclaimer')

block column 
  include ./components/shared/column/column.pug
