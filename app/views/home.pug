extends layout.pug

block append meta
  meta(name="og:title" content="")
  meta(name="og:description" content="")
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('Hello') 
  meta(name="description" content=__('Hello'))
  meta(name="keywords" content="")

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  h1= __('index.title')
  h2= __('index.subtitle')
  div
    //- cmp-bullet(type="blue", topic="performance", direction="positive")
    //-   span(slot="title") Best performance
    //-   span(slot="name") A2a
    //-   span(slot="value") +33.7%
    cmp-card(color="blue")
      span(slot="title")= __('milanStockExchange')
      a(slot="image", title=__('milanStockExchange'), href="milano")
        img(src="/assets/images/exchanges/borsa-italiana.webp", class="cmp-card-slotted-img")
      span(slot="subtitle")= __('milanStockExchange')
      span(slot="description") Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas sed commodo arcu, non venenatis eros.
      span(slot="link")
        a(href="#", title=__('milanStockExchange'))= __('index.discoverStocks')
    cmp-card(color="yellow")
      span(slot="title")= __('parisStockExchange')
      a(slot="image", title=__('parisStockExchange'), href="paris")
        img(src="/assets/images/exchanges/bourse_de_paris.webp", class="cmp-card-slotted-img")
      span(slot="subtitle")= __('parisStockExchange')
      span(slot="description") Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas sed commodo arcu, non venenatis eros.
      span(slot="link")
        a(href="#", title=__('parisStockExchange'))= __('index.discoverStocks')

block column 
  include ./components/shared/column/column.pug