extends layout.pug

block append meta
  meta(name="og:title" content= __('stock.meta.title', {stock: __(stock.name)}) + ' | ' + __('proj_name') )
  meta(name="og:description" content= __('stock.meta.description', {stock: __(stock.name)}) )
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('stock.meta.title', {stock: __(stock.name)}) + ' | ' + __('proj_name')
  meta(name="description" content= __('stock.meta.description', {stock: __(stock.name)}) )
  meta(name="keywords" content= __('stock.meta.keywords', {stock: __(stock.name)}))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ./components/shared/breadcrumbs/breadcrumbs.pug

  h1(id="stock-name") #{stock.name}
  section(class="details")
    div(class="flex")
      dl
        dt= __('isin')
        dd #{stock.isin}
        dt= __('code')
        dd #{stock.code}
      dl
        dt= __('market')
        dd #{stock.market}
        dt= __('currency')
        dd #{stock.currency}
      dl
        dt= __('website')
        dd
          a(href="#", title=__('seeOnEuronext'), id="euronext", data-url=stock.sources[0], data-isin=stock.isin)= __('seeOnEuronext', {stock: stock.name})
        dt= __('status')
        dd #{stock.status}


  section
    span(class="lastmod")= __('stock.lastmod', { lastmod: new Date(stock.updatedAt).toLocaleString(lang, {dateStyle: 'long', timeStyle: 'short'}) })
    h2= __('details')
    div(class="bullet-wrap")
      cmp-light-bullet(direction=stock.relVariation > 0 ? 'positive' : 'negative')
        span(slot="head") #{stock.name}
        span(slot="name")= __('relVariation')
        span(slot="value") #{stock.relVariation}<small>%</small>
      cmp-light-bullet
        span(slot="head") #{stock.name}
        span(slot="name")= __('lastPrice')
        span(slot="value") #{stock.price}<small>€</small>
      cmp-light-bullet
        span(slot="head") #{stock.name}
        span(slot="name")= __('volume')
        span(slot="value") #{(stock.volume / 1000000).toFixed(3)}<small>Mln.</small>

  section
    h2= __('performance')
    div(class="bullet-wrap")
      cmp-light-bullet(direction=stock.perf1M > 0 ? 'positive' : 'negative')
        span(slot="head") #{stock.name}
        span(slot="name")= __('monthPerformance')
        span(slot="value") #{stock.perf1M}<small>%</small>
      cmp-light-bullet(direction=stock.perf52W > 0 ? 'positive' : 'negative')
        span(slot="head") #{stock.name}
        span(slot="name")= __('yearPerformance')
        span(slot="value") #{stock.perf52W}<small>%</small>

  section
    h2= __('stock.graph')
    div(id="stock-graph")
      canvas(id="myChart", data-volumes=history.volumes, data-prices=history.prices)


  section(class="center")
    h2= __('index.sectionAVA.title')
    p= __('index.sectionAVA.text')
    p(id="ava-banner-5")

  aside(id="disclaimer")!= __('disclaimer')


block column 
  include ./components/shared/column/column.pug    