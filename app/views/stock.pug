extends layout.pug

block append meta
  meta(name="og:title" content= __('stock.meta.title', {stock: __(stock.name)}) + ' | ' + __('proj_name') )
  meta(name="og:description" content= __('stock.meta.description', {stock: __(stock.name)}) )
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('stock.meta.title', {stock: __(stock.name)}) + ' | ' + __('proj_name')
  meta(name="description" content= __('stock.meta.description', {stock: __(stock.name)}) )
  meta(name="keywords" content= __('stock.meta.keywords', {stock: __(stock.name)}))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ./components/shared/breadcrumbs/breadcrumbs.pug

  h1(id="stock-name") #{stock.name}

  section
    h2 Dettagli 
    div(class="bullet-wrap")
      cmp-bullet
        span(slot="head") #{stock.name}
        span(slot="name")= __('lastPrice')
        span(slot="value") #{stock.price}
      cmp-bullet(direction=stock.relVariation > 0 ? 'positive' : 'negative')
        span(slot="head") #{stock.name}
        span(slot="name")= __('relVariation')
        span(slot="value") #{stock.relVariation}
      cmp-bullet
        span(slot="head") #{stock.name}
        span(slot="name")= __('volume')
        span(slot="value") #{stock.volume}


  section
    h2 Grafico 
    div(id="stock-graph")
      canvas(id="myChart", data-volumes=stock.history.volume, data-prices=stock.history.price)

  section
    h2 Performance 
    div(class="bullet-wrap")
      cmp-bullet(direction=stock.perf1M > 0 ? 'positive' : 'negative')
        span(slot="head") #{stock.name}
        span(slot="name")= __('monthPerformance')
        span(slot="value") #{stock.perf1M}
      cmp-bullet(direction=stock.perf52W > 0 ? 'positive' : 'negative')
        span(slot="head") #{stock.name}
        span(slot="name")= __('yearPerformance')
        span(slot="value") #{stock.perf52W}

  aside(id="disclaimer") #[em Attenzione: ] operare in Borsa e fare trading costituiscono #[em azioni ad alto rischio]. Le informazioni qui presentate non costituiscono una sollecitazione di acquisto o vendita di titoli azionari e si intendono #[em per puro uso informativo]. Il Portale Web tradingradar.net non si dichiara responsabile di un utilizzo improprio delle informazioni qui ottenute.


block column 
  include ./components/shared/column/column.pug    