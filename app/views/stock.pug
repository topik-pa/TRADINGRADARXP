extends layout.pug

block append meta
  meta(name="og:title" content= __('stock.meta.title', {stock: __(stockUrl)}) + ' | ' + __('proj_name') )
  meta(name="og:description" content= __('stock.meta.description', {stock: __(stockUrl)}) )
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('stock.meta.title', {stock: __(stockUrl)}) + ' | ' + __('proj_name')
  meta(name="description" content= __('stock.meta.description', {stock: __(stockUrl)}) )
  meta(name="keywords" content= __('stock.meta.keywords', {stock: __(stockUrl)}))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ./components/shared/breadcrumbs/breadcrumbs.pug
  
  h1(id="stock-name")

  section
    h2 Dettagli 
    div(id="stock-details", class="bullet-wrap")


  section
    h2 Grafico 
    div(id="stock-graph")
      canvas(id="myChart")

  section
    h2 Performance 
    div(id="stock-performance", class="bullet-wrap")

  aside(id="disclaimer") #[em Attenzione: ] operare in Borsa e fare trading costituiscono #[em azioni ad alto rischio]. Le informazioni qui presentate non costituiscono una sollecitazione di acquisto o vendita di titoli azionari e si intendono #[em per puro uso informativo]. Il Portale Web tradingradar.net non si dichiara responsabile di un utilizzo improprio delle informazioni qui ottenute.


block column 
  include ./components/shared/column/column.pug    