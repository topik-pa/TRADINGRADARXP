extends layout.pug

block append meta
  meta(name="og:title" content=__('views.about') + ' | ' + __('proj_name'))
  meta(name="og:description" content=__('about.meta.description'))
  meta(name="og:image" content=og_image)
  meta(name="og:url" content=canonicalUrl)

  title= __('views.about') + ' | ' + proj_name
  meta(name="description" content=__('about.meta.description'))
  meta(name="keywords" content=__('about.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  h1= __('about.title')
  p Work in progress...
